<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Informix.Data.Tests" />
  </ItemGroup>

  <!--
    Structured logging via Microsoft.Extensions.Logging (source-generated
    [LoggerMessage] methods). This is the only package dependency; the wire,
    pooling and data-source layers otherwise stand alone.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>Informix.Data</AssemblyName>
    <RootNamespace>Informix.Data</RootNamespace>
    <Description>Experimental managed ADO.NET provider for IBM Informix (SQLI protocol).</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Versioning: MinVer derives Version/PackageVersion from the latest git tag
    (vMAJOR.MINOR.PATCH). Commits after a tag build as the next patch with an
    "-alpha.0.N" pre-release suffix. AssemblyVersion is pinned to MAJOR.0.0.0.
    Release = push a tag (see .github/workflows/release.yml).
  -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!-- NuGet packaging (`dotnet pack`). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Informix.Data</PackageId>
    <RepositoryUrl>https://github.com/robsosno/Informix.Data</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>robsosno</Authors>
    <PackageDescription>Experimental managed ADO.NET provider for IBM Informix (SQLI protocol). No CSDK, no ODBC DSN, no IBM DB2 client required.</PackageDescription>
    <PackageTags>informix;ado.net;database;driver;sqli</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkg</PackageOutputPath>
    <Copyright>Copyright (c) 2026 Robert Sosnowski</Copyright>
    <!--
      XML docs for IntelliSense. Not enforced: CS1591 (public member without a comment),
      CS1573 (only some <param> tags present), CS0419 (cref to an overloaded method group).
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
  </PropertyGroup>

  <!-- README, LICENSE live in the repository root, one level above this project. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
