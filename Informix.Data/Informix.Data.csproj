<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Informix.Data.Tests" />
  </ItemGroup>

  <!--
    Structured logging via Microsoft.Extensions.Logging (source-generated
    [LoggerMessage] methods). This is the only package dependency; the wire,
    pooling and data-source layers otherwise stand alone.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>Informix.Data</AssemblyName>
    <RootNamespace>Informix.Data</RootNamespace>
    <Description>Managed ADO.NET provider for IBM Informix (SQLI protocol).</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet packaging (`dotnet pack`). Bump <Version> manually per release. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Informix.Data</PackageId>
    <Version>1.0.0</Version>
    <Authors>Informix.Data contributors</Authors>
    <PackageDescription>Managed ADO.NET provider for IBM Informix (SQLI protocol). No CSDK, no ODBC DSN, no IBM DB2 client required.</PackageDescription>
    <PackageTags>informix;ado.net;database;driver;sqli</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkg</PackageOutputPath>
  </PropertyGroup>

  <!-- README, LICENSE and docs/ live in the repository root, one level above this project. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\docs\**\*.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

</Project>
