# Copy this file to .env (git-ignored: it holds a password). One file for all demo programs.
#
# The connection string needs no Database key; the programs set it (superstore_demo2).
INFORMIX_DEMO_CONNECTION=Host=your-host;Service=9088;Server=your_server;User ID=your_user;Password=your_password;Authentication=Pam

# --- Optional -------------------------------------------------------------------------------
# Another database than superstore_demo2:
# INFORMIX_DEMO_DATABASE=superstore_demo2
#
# Keywords merged into the connection string:
# INFORMIX_DEMO_OPTIONS=Pooling=false
#
# Provider the 03-abstraction programs ask DbProviderFactories for:
# INFORMIX_DEMO_PROVIDER=Informix.Data
#
# Something that applies to one program only: put just that line in a .env next to the program's
# .csproj (e.g. 02-native/ConnectionPooling/.env). It overrides this file for that program; all
# other settings still come from here. A real environment variable beats both files.
