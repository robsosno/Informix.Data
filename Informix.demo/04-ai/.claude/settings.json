{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * *.env*)",
      "Bash(source *.env*)",
      "Bash(printenv*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(Select-String * *.env*)",
      "PowerShell(Get-ChildItem Env:*)"
    ]
  }
}
