# Copy this file to .env. Only the InformixMcp process reads it; .env is listed in .gitignore and
# denied to the assistant in .claude/settings.json.
#
# The server adds "Select Only=true;Read Only=true" to this string and overrides any value you put
# there for those two keywords. The database must have transaction logging (read-only transactions).
INFORMIX_MCP_CONNECTION=Host=your-host;Service=9088;Server=your_server;Database=superstore_demo2;User ID=your_user;Password=your_password;Authentication=Pam
